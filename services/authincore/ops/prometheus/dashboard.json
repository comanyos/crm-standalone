{
  "title": "AuthinCore Golden Signals",
  "schemaVersion": 39,
  "panels": [
    {"type":"timeseries","title":"Request rate","targets":[{"expr":"sum(rate(authincore_http_requests_total[5m]))"}]},
    {"type":"timeseries","title":"HTTP error rate","targets":[{"expr":"sum(rate(authincore_http_requests_total{status=~\"5..\"}[5m]))"}]},
    {"type":"timeseries","title":"P95 latency","targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(authincore_http_request_duration_seconds_bucket[5m])))"}]},
    {"type":"timeseries","title":"Login outcomes","targets":[{"expr":"sum by (outcome) (rate(authincore_login_total[5m]))"}]},
    {"type":"timeseries","title":"Webhook failures","targets":[{"expr":"rate(authincore_webhook_deliveries_total{outcome=\"failed\"}[5m])"}]},
    {"type":"stat","title":"Active sessions","targets":[{"expr":"authincore_active_sessions"}]}
  ]
}
