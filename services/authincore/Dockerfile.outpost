FROM golang:1.26-alpine AS builder
RUN apk add --no-cache git ca-certificates

WORKDIR /app
COPY go.mod go.sum ./
COPY third_party/platform-contract ./third_party/platform-contract
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/outpost ./cmd/outpost

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /bin/outpost /outpost
USER 65532:65532
EXPOSE 9090
ENTRYPOINT ["/outpost"]
