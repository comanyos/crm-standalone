# Copy to .env and fill in after `make bootstrap` (see repo root README.md).
# All variables must be prefixed VITE_ to be exposed to browser code — see
# https://vite.dev/guide/env-and-mode.html. Never put a client secret here:
# this is a public (PKCE) OAuth client and the bundle is fully readable.

# AuthinCore's public issuer origin. Must be reachable directly from the
# browser (not proxied) — the login redirect is a full top-level navigation,
# and the token exchange/logout calls rely on AuthinCore's CORS allowlist
# (CORS_ALLOWED_ORIGINS on the authincore service) rather than a dev proxy.
VITE_AUTH_ISSUER_URL=http://localhost:18080

# The org this deployment serves — printed by `make bootstrap` as
# "OrganizationID". AuthinCore's /oauth2/authorize and /oauth2/token require
# it explicitly; there is no safe default.
VITE_AUTH_ORG_ID=

# Matches the public SPA client `authinctl bootstrap` creates.
VITE_AUTH_CLIENT_ID=crm-web

VITE_CRM_API_URL=http://localhost:19431

# Must match CRM_WEB_ORIGIN / CRM_WEB_REDIRECT_URI in the root .env.
# The default is 3000. Use another free local port only after updating both
# backend settings and re-running `make bootstrap`.
VITE_WEB_PORT=3000

# Local development only. Binding to loopback prevents accidental LAN exposure.
VITE_WEB_HOST=127.0.0.1
