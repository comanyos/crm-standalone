# Copy to .env for local development. VITE_ values are readable in the
# browser bundle, so never put an SMTP password, signing key, or other secret
# here. Authentication secrets belong only in the CRM API environment.

VITE_CRM_API_URL=http://localhost:19431
VITE_CRM_AUTH_PORTAL_URL=http://localhost:4173/?auth=login#top

# Local development only. The production container is served by nginx.
VITE_WEB_PORT=3003
VITE_WEB_HOST=127.0.0.1
