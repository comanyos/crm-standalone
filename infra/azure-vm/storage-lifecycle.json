{
  "rules": [
    {
      "enabled": true,
      "name": "expire-savvy-crm-database-backups",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": {
            "delete": {
              "daysAfterModificationGreaterThan": 35
            }
          }
        },
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["db-backups/crm-"]
        }
      }
    }
  ]
}
