# development | test | staging | production — see docs/CONFIGURATION.md.
# Leave unset (or "development") for local `make up`. The CRM API rejects
# development credentials and insecure browser/session settings in staging
# and production.
APP_ENV=development

CRM_PUBLIC_URL=http://localhost:19431

# Local development values only. Replace outside local development.
CRM_DB_ADMIN_PASSWORD=crm_admin_dev
CRM_DB_APP_PASSWORD=crm_app
CRM_DB_DRAIN_PASSWORD=crm_drain

CRM_WEB_PORT=3003
CRM_WEB_ORIGIN=http://localhost:3003
# Public marketing-site dialog that owns Login and Sign up. The CRM app's
# compatibility /login route immediately redirects here.
CRM_AUTH_PORTAL_URL=http://localhost:4173/?auth=login#top

# Exact origin allowed to make authenticated CRM API calls. Empty uses
# CRM_WEB_ORIGIN. Never add the public marketing site here.
CRM_CORS_ALLOWED_ORIGINS=

# Origins allowed to call only the public authentication/onboarding routes.
# Compose defaults this to the two local port-4173 preview origins. Production
# should set only the deployed HTTPS marketing origin(s).
AUTH_CORS_ALLOWED_ORIGINS=

# Idempotent first workspace/admin bootstrap. No password is created: the
# administrator signs in by email OTP or Google. Leave all three blank after
# the first successful bootstrap in a managed production environment.
AUTH_BOOTSTRAP_ORG_NAME=
AUTH_BOOTSTRAP_EMAIL=
# Optional stable UUID when importing an existing tenant's CRM rows.
AUTH_BOOTSTRAP_ORG_ID=

# Native CRM session settings. Cookies are HttpOnly and SameSite; Secure must
# be true outside local HTTP development.
AUTH_SESSION_TTL=720h
AUTH_OTP_TTL=10m
AUTH_COOKIE_NAME=savvy_session
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_SUCCESS_URL=http://localhost:3003
AUTH_JOIN_RESULT_URL=http://localhost:4173/?auth=signup#top
# Exactly six digits; accepted only when APP_ENV=test.
AUTH_DEV_OTP=

# --- Auth email delivery (required for production passwordless email OTP) ---
#
# Leave SMTP_HOST blank to keep email delivery disabled during local work. A
# production deployment must inject all provider values from its secret/config
# store. Never commit SMTP credentials here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Customer-visible sender. The existing Savvy website uses this mailbox;
# the selected SMTP provider must verify it before production delivery.
SMTP_FROM="Savvy CRM <support@savvyadvi.com>"
# SMTP_TLS=true selects implicit TLS (normally port 465).
SMTP_TLS=false
# On an explicit-TLS connection (normally port 587), production must require
# STARTTLS so delivery fails closed instead of falling back to plaintext.
SMTP_REQUIRE_STARTTLS=true

# Secret HMAC key protecting pending passwordless login codes in CRM Postgres.
# Empty uses Compose's development-only fallback. Staging/production
# must inject an independent random value of at least 32 bytes, for example:
#   openssl rand -base64 48
OTP_PEPPER=

# --- Google account sign-in (optional until the OAuth client is created) ---
# This client requests only identity scopes and must be separate from the
# Gmail/Calendar integration client below.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_REDIRECT_URL=http://localhost:19431/auth/google/callback

# --- Google integration (optional; see docs/GOOGLE_INTEGRATION.md) ---
#
# Leave these unset to run without it: the CRM starts normally and the
# Connected accounts page says the feature is not configured. Set them and the
# CRM requires the complete set — a client ID with no sealing key would offer a
# Connect button that cannot store what it receives.
#
# NEVER put the client secret or the token key in this file, in source control,
# in browser configuration, or in chat. Inject them through the deployment's
# secret mechanism. Generate the token key with `openssl rand -base64 32`.
#
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:19431/integrations/google/callback
# GOOGLE_OAUTH_TOKEN_KEY=
#
# Where the OAuth callback returns the browser. Unset is safe: the callback
# renders its own result page rather than guessing an origin from the request.
# CRM_WEB_APP_BASE_URL=http://localhost:3003
#
# How long synced email and meetings are kept. 0 — the default — keeps them
# until somebody asks for them to go. Setting this deletes an organization's
# own correspondence history on a schedule, so set it deliberately.
# SYNC_RETENTION_DAYS=0

# Inbound lead capture (docs/LEAD_CAPTURE.md). Base64-encoded 32 random bytes,
# sealing each capture endpoint's HMAC signing secret. Leave unset to keep the
# feature off: there is no unsigned mode, so an endpoint either verifies
# signatures or does not exist.
#   openssl rand -base64 32
LEAD_CAPTURE_SECRET_KEY=

# --- Meta / Facebook / Instagram Lead Ads (optional; all-or-none) ---
# Create a Savvy-owned Meta Business app and register these public endpoints:
#   OAuth redirect: http://localhost:19431/integrations/meta/callback
#   Page webhook:   http://localhost:19431/integrations/meta/webhook
# Production uses the corresponding https://crmapi.savvyadvi.com URLs.
# Keep the app secret and token key in the deployment secret manager. The
# webhook verify token is a random value shared only with Meta's webhook setup.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URL=
META_WEBHOOK_VERIFY_TOKEN=
# Base64-encoded 32 random bytes: openssl rand -base64 32
META_TOKEN_KEY=
# Pin deliberately and re-test before changing.
META_GRAPH_VERSION=v25.0
