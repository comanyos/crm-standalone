# development | test | staging | production — see docs/CONFIGURATION.md.
# Leave unset (or "development") for local `make up`. crm-api and authincore
# both refuse to start in staging/production with development-default
# passwords, a non-https issuer, or an ephemeral signing key.
APP_ENV=development

AUTH_PUBLIC_URL=http://localhost:18080
AUTH_ADMIN_URL=http://localhost:13001
CRM_PUBLIC_URL=http://localhost:19431

# Local development values only. Replace outside local development.
AUTH_DB_PASSWORD=authincore_dev
CRM_DB_ADMIN_PASSWORD=crm_admin_dev
CRM_DB_APP_PASSWORD=crm_app
CRM_DB_DRAIN_PASSWORD=crm_drain

# Generated locally by: make dev-key
JWT_PRIVATE_KEY_FILE=./deploy/secrets/jwt_private_key.pem

# One-time local bootstrap. These values are intentionally blank and must not
# be committed with production credentials.
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_DOMAIN=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
CRM_WEB_CLIENT_ID=crm-web
CRM_WEB_REDIRECT_URI=http://localhost:3000/auth/callback
CRM_WEB_PORT=3000
# Non-secret organization UUID printed by `make bootstrap`; required to build
# the standalone web image with its public OIDC configuration.
CRM_WEB_AUTH_ORG_ID=

# apps/web's browser origin. Drives both authincore's and crm-api's
# CORS_ALLOWED_ORIGINS (see docs/CONFIGURATION.md). Change together with
# CRM_WEB_REDIRECT_URI and apps/web's dev server port if 3000 is unavailable.
CRM_WEB_ORIGIN=http://localhost:3000
